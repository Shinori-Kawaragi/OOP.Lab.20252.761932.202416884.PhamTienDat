public int compareTo(Media other){
	int tmp = this.getTitle().compareToIgnoreCase(other.getTitle());
        if(tmp != 0) return tmp;
	if(this instanceof DVD && other instanceof DVD){
		DVD thisDVD = (DVD)this;
		DVD otherDVD = (DVD)other;
		int tmp1 = Integer.compare(thisDVD.getLength(),otherDVD.getLength());
		if(tmp1!=0) return -tmp1;
	}
        return Float.compare(this.getPrice(),other.getPrice());
}


